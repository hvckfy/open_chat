# Raw TCP passthrough for libp2p (validator-to-validator gossip/consensus
# traffic), so both nodes stay reachable through the same single public
# IP as the gRPC gateway, on two different external ports. libp2p already
# encrypts this traffic itself (Noise/TLS, see internal/p2p/host.go), so
# nginx here does dumb L4 forwarding — no cert/SNI handling needed, unlike
# openchat-grpc.conf.example.
#
# This must live in nginx's top-level `stream {}` block (NOT inside
# `http {}`), typically included from /etc/nginx/nginx.conf:
#   stream {
#       include /etc/nginx/stream-enabled/*.conf;
#   }
# Requires nginx built with --with-stream (stock on Debian/Ubuntu
# nginx-full, and on nginx.org's official packages).
#
# With this in place, node1's P2P_LISTEN_ADDRS stays
# /ip4/0.0.0.0/tcp/4001 as usual; what changes is what you tell *other*
# nodes to dial: your single public IP on the external port below,
# instead of node1's own host:4001 directly.
#
#   /ip4/<your-public-ip>/tcp/4001/p2p/<node1-peer-id>   (-> node1 host)
#   /ip4/<your-public-ip>/tcp/4002/p2p/<node2-peer-id>   (-> node2 host)
#
# Get <nodeN-peer-id> from `app/golang/cmd/keytool` (see docs/deploy.md).

server {
    listen 4001;
    listen [::]:4001;
    proxy_pass 10.0.0.11:4001;   # node1's Docker host
    proxy_timeout 1h;
}

server {
    listen 4002;
    listen [::]:4002;
    proxy_pass 10.0.0.12:4001;   # node2's Docker host (note: internal port is still 4001)
    proxy_timeout 1h;
}
