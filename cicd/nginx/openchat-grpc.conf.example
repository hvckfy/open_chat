# Single entry point (1 public IP), two domains, each routed by SNI/Host
# to a different validator's Docker host, with TLS terminated here by
# nginx using real (e.g. Let's Encrypt) certificates. Each node behind
# this must run with GRPC_TLS_ENABLED=false (see cicd/docker/docker-compose.yml /
# the Portainer stack) since nginx now owns the TLS handshake — grpc_pass
# talks plaintext HTTP/2 to the backend, which is exactly what grpc-go's
# grpc.NewServer() (no credentials.TransportCredentials) serves.
#
# Install once: nginx >= 1.13.10 built with http_v2 (stock on
# Debian/Ubuntu's nginx-full / nginx-extras, and on nginx.org's official
# packages). Get certs with certbot, e.g.:
#   certbot certonly --nginx -d node1.example.com -d node2.example.com
#
# Replace node1.example.com / node2.example.com and the two upstream
# addresses below with your real values, then:
#   cp openchat-grpc.conf.example /etc/nginx/sites-available/openchat-grpc.conf
#   ln -s /etc/nginx/sites-available/openchat-grpc.conf /etc/nginx/sites-enabled/
#   nginx -t && systemctl reload nginx

upstream openchat_node1 {
    # Wherever validator 1's container actually listens — same host on a
    # different port, or a different host/VPN IP entirely. This is a
    # plaintext (no TLS) hop, so keep it on a network you trust (private
    # LAN/VPN, not the open internet).
    server 10.0.0.11:9090;
}

upstream openchat_node2 {
    server 10.0.0.12:9090;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name node1.example.com;

    ssl_certificate     /etc/letsencrypt/live/node1.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/node1.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        grpc_pass grpc://openchat_node1;

        # StreamIncomingSMS is a long-lived server stream — don't let
        # nginx time it out or buffer it.
        grpc_read_timeout 3600s;
        grpc_send_timeout 3600s;
        client_body_timeout 3600s;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name node2.example.com;

    ssl_certificate     /etc/letsencrypt/live/node2.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/node2.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        grpc_pass grpc://openchat_node2;
        grpc_read_timeout 3600s;
        grpc_send_timeout 3600s;
        client_body_timeout 3600s;
    }
}

# Plain HTTP -> HTTPS redirect + ACME HTTP-01 challenge path for certbot.
server {
    listen 80;
    listen [::]:80;
    server_name node1.example.com node2.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- Notes for newer nginx (>= 1.25.1) ---------------------------------
# `listen ... http2;` is deprecated in favor of a separate `http2 on;`
# directive:
#   listen 443 ssl;
#   http2 on;
# Both forms work on 1.25.x; only the old form works before 1.25.1, and
# only the new form is guaranteed going forward — check `nginx -v`.
