# syntax=docker/dockerfile:1

# ---------- build stage ----------------------------------------------------
FROM golang:1.22-bookworm AS build
WORKDIR /src

# Cache module downloads separately from source changes.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .

# `go.sum` isn't checked in yet (see README "Honest caveats"), so
# `go mod download` above only resolves direct requires — `go mod tidy`
# here (now that the full source is present) resolves every transitive
# import and writes a complete go.sum before we build. Once you've run
# `go mod tidy` locally and committed go.sum, this line becomes a no-op
# and can be removed for slightly faster/more reproducible builds.
RUN go mod tidy

# Static binary: no libc dependency, so it runs on distroless/static.
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /out/openchat-node ./cmd/node

# ---------- runtime stage ---------------------------------------------------
# distroless/static: no shell, no package manager, minimal attack surface.
FROM gcr.io/distroless/static-debian12:nonroot AS runtime

# distroless/static:nonroot already runs as uid 65532 ("nonroot"), but we
# pin it explicitly for clarity/auditability.
USER 65532:65532

COPY --from=build --chown=65532:65532 /out/openchat-node /usr/local/bin/openchat-node

# Chain DB lives on a volume; TLS material is mounted from a Docker/K8s
# secret at runtime (see docker-compose.yml / deployments/k8s).
VOLUME ["/data"]

EXPOSE 4001/tcp 9090/tcp 2112/tcp

ENTRYPOINT ["/usr/local/bin/openchat-node"]
